# Robot Kiosk Browser settings
#
# This file is everything robot-browser needs. The package installs and runs
# standalone: edit the URLs below and it works, with no other software layer
# present.
#
# It is a dpkg conffile, so changes made here survive package upgrades.
#
# Precedence: built-in defaults < this file < command line. A provisioning
# layer that already holds the URLs (for example robot-scada-client on the
# T430/T440) integrates by passing them as arguments:
#
#     robot-browser <remote_url> [local_url]
#
# so it never has to write to this file, and this package never has to know
# that layer exists.
#
# (C) 2017-2026, Radical Electronic Systems
# http://www.radicalsystems.co.za  info@radicalsystems.co.za

# --- Pages -----------------------------------------------------------------

# Both are commented out on purpose. A value here is a decision, and this file
# is installed on every machine the package touches — so an uncommented default
# pins the terminal to 127.0.0.1 and outranks everything that knows better: the
# --profile=desktop starting pages on a PC, and the built-in defaults. Set them
# when this file is the thing that knows where the terminal points.

# Remote URL — the business/transaction page, and the page the browser opens
# with. Reached from the pallet button.
#WB_REMOTE_URL=http://127.0.0.1

# Local URL — the on-device web UI. Reached from the home button.
#WB_LOCAL_URL=http://127.0.0.1

# --- Networking ------------------------------------------------------------
#
# Which network types this terminal offers. Each is auto, on or off:
#
#   auto  offer it when NetworkManager reports the hardware   (default)
#   on    always offer it, even with no device present, so a terminal that is
#         supposed to have the link shows that it is missing rather than
#         hiding it
#   off   never offer it: no button, and the device is never polled, scanned
#         or talked to at all
#
# Typical deployments:
#
#   T430 (wired)          NETWORK_LAN=on    NETWORK_WIFI=off
#   T440 (WiFi roaming)   NETWORK_LAN=off   NETWORK_WIFI=on
#   general terminal      NETWORK_LAN=auto  NETWORK_WIFI=auto
#
# Both can be overridden for testing without editing this file:
#
#     robot-browser --wifi=off --lan=on <remote_url>

NETWORK_WIFI=auto
NETWORK_LAN=auto

# --- Display ---------------------------------------------------------------

# Display orientation: portrait or landscape. Used by the launcher scripts.
WB_LAYOUT=landscape
