[Desktop Entry]
Type=Application
Version=1.0
Name=Robot Browser
GenericName=Kiosk Browser
Comment=Two-URL kiosk browser for RadicalES Robot terminals
# Installed to /usr/share/applications, so it is in the menu for every user on
# the machine rather than for whoever happened to install it.
Exec=robot-browser --profile=user
# An absolute path, not the icon NAME the theme would look up.
#
# GNOME Shell caches icons by name and never invalidates that cache when the
# file behind the name changes: 3.3.1 shipped a green mark, 3.4.0 replaced it
# with the orange one, and shells that had seen the green one kept drawing it
# for as long as the session lived - which can be months. A path is resolved
# directly, so an upgrade that changes the file is seen.
Icon=/usr/share/icons/hicolor/scalable/apps/robot-browser.svg
Terminal=false
Categories=Network;WebBrowser;
Keywords=robot;kiosk;terminal;radicales;
StartupNotify=true
StartupWMClass=robot-browser
# The device profiles, so somebody writing a webapp for a terminal can start
# one at the terminal's own viewport without remembering the flag. Right-click
# the menu entry (or the launcher) to reach them.
Actions=T430;T431;T432;T440;ITPC200;

[Desktop Action T430]
Name=Open as a Robot-T430
Exec=robot-browser --profile=t430

[Desktop Action T431]
Name=Open as a Robot-T431
Exec=robot-browser --profile=t431

[Desktop Action T432]
Name=Open as a Robot-T432
Exec=robot-browser --profile=t432

[Desktop Action T440]
Name=Open as a Robot-T440
Exec=robot-browser --profile=t440

[Desktop Action ITPC200]
Name=Open as an ITPC-200
Exec=robot-browser --profile=itpc200
